include COPYING CORRESPONDING_SOURCE.md Makefile README.md THIRD_PARTY_NOTICES.md
include build_exe.bat run_tool.bat requirements.txt requirements.in requirements-lock.txt requirements-build.txt
include native_target.py
recursive-include packaging *.py *.ps1 *.sh *.spec *.md *.txt
include packaging/generate_provenance.py packaging/release_inventory.json packaging/release_components.json
recursive-include requirements-targets *.txt *.json
include tokens/mbuprime_structlab.tokens.json tokens/mbuprime_structlab.registry.json
include assets/generate_app_icon.py
recursive-include assets *.ico *.svg *.ttf *.txt *.conf
recursive-include native *.cpp *.py *.ps1
recursive-include rnastructure_native *.py *.json *.dat *.dg *.dh
recursive-include vendor/rnastructure-6.6 COPYING README.md RNAstructureSource.zip
recursive-include vendor/seqfold-0.10.2 LICENSE
global-exclude *.pyd *.so *.pyc
prune build
prune dist
prune release
prune tests
prune .github
prune .agents
prune .claude
